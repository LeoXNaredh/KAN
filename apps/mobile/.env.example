# Supabase (docs/18 §2) — mismo proyecto que usa apps/web. Project URL y
# anon public key desde Settings → API en supabase.com. Nunca la
# service_role key acá: este es un binario distribuido.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL de apps/web (docs/18 §1) — la app móvil nunca habla con el
# Gateway ni con Gemini directo, siempre a través de /api/chat y
# /api/voice/transcribe de este servidor.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
