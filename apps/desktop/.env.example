# ESP32 / Arduino (@kan/plugin-esp32-arduino) — sin ninguna de las dos
# variables de abajo, discover() escanea todos los puertos seriales
# disponibles probando un "ping" en cada uno (nunca escanea la red LAN
# entera: WiFi solo conecta a los hosts que fijes explícitamente).

# Un puerto serial fijo, para saltarte el escaneo automático (ej. COM3 en
# Windows, /dev/ttyUSB0 en Linux).
KAN_ESP32_PORT=

# Host(s) WiFi/TCP del firmware kan_esp32_bridge_wifi.ino — separados por
# coma, puerto opcional por host (default 8266 si se omite).
# Ej: KAN_ESP32_WIFI_HOSTS=192.168.1.50 o 192.168.1.50:8266,192.168.1.51
KAN_ESP32_WIFI_HOSTS=

# Modbus TCP + RTU serial (@kan/plugin-modbus). `nombre|tipo|conexión`
# separados por coma — tipo es "tcp" o "rtu-serial". Nunca escanea.
# Ej: KAN_MODBUS_TARGETS=plc1|tcp|192.168.1.50:502,sensor1|rtu-serial|COM3:9600
KAN_MODBUS_TARGETS=

# Puerto serial genérico ASCII/texto (@kan/plugin-serial-generic) — para
# dispositivos sin protocolo fijo cubierto por otro plugin. `nombre|puerto|
# baudRate` separados por coma, baudRate opcional (default 9600).
# Ej: KAN_SERIAL_TARGETS=sensor1|COM3|115200
KAN_SERIAL_TARGETS=

# CAN Bus vía adaptador USB-CAN compatible SLCAN (@kan/plugin-canbus) —
# CANable, CANtact, USBtin, CANUSB. `nombre|puerto|bitrate` separados por
# coma, bitrate opcional en bit/s (default 500000).
# Ej: KAN_CANBUS_TARGETS=obd|COM4|500000
KAN_CANBUS_TARGETS=

# Cliente HTTP genérico (@kan/plugin-http-generic) — para cualquier API REST
# sin un plugin dedicado. `nombre|baseUrl|Header:valor` separados por coma,
# el header es opcional.
# Ej: KAN_HTTP_ENDPOINTS=clima|https://api.clima.example.com|Authorization:Bearer xyz
KAN_HTTP_ENDPOINTS=

# Cliente WebSocket genérico (@kan/plugin-ws-generic). `nombre|wsUrl|
# Header:valor` separados por coma, el header es opcional.
# Ej: KAN_WS_ENDPOINTS=sensores|ws://192.168.1.20:8080
KAN_WS_ENDPOINTS=

# Home Assistant (@kan/plugin-home-assistant, reusa el transporte de
# plugin-http-generic). `nombre|baseUrl|token` separados por coma — el token
# es un Long-Lived Access Token generado desde el perfil de usuario en HA.
# Ej: KAN_HOME_ASSISTANT_INSTANCES=casa|http://homeassistant.local:8123|eyJhbGciOi...
KAN_HOME_ASSISTANT_INSTANCES=

# Wake-on-LAN (@kan/plugin-network-tools) — `nombre|macAddress|broadcastIp:puerto`
# separados por coma, broadcastIp:puerto opcional (default 255.255.255.255:9).
KAN_WOL_TARGETS=

# SNMP de solo lectura (@kan/plugin-network-tools) — `nombre|host:puerto|community`
# separados por coma, puerto y community opcionales (default 161/public).
KAN_SNMP_TARGETS=

# SSH — control remoto de otras PCs (@kan/plugin-ssh). Allowlist de hosts
# OBLIGATORIA — sin esta variable, el plugin no expone ningún dispositivo.
# `nombre|host:puerto|usuario|auth` separados por coma — auth es
# "key|/ruta/a/la/clave[|passphrase]" o "password|contraseña".
# execute_command y write_file son safety-critical por defecto.
KAN_SSH_HOSTS=

# OPC-UA industrial (@kan/plugin-opcua). `nombre|endpointUrl|usuario|
# contraseña` separados por coma — usuario/contraseña opcional (anónimo por
# defecto).
# Ej: KAN_OPCUA_TARGETS=plc1|opc.tcp://192.168.1.60:4840
KAN_OPCUA_TARGETS=

# MQTT (@kan/plugin-mqtt) — URLs de broker separadas por coma, nunca escanea
# la red. Credenciales van en la URL (mqtt://usuario:contraseña@host:puerto).
# Ej: KAN_MQTT_BROKERS=mqtt://192.168.1.10:1883
KAN_MQTT_BROKERS=

# Impresión 3D / CNC por G-code (@kan/plugin-gcode). Un puerto serial fijo
# (no escanea) y/o un bridge serial-a-red (WiFi/TCP), sin puerto por
# defecto asumido — sin ambas variables de WiFi, no intenta conectarse.
KAN_GCODE_SERIAL_PORT=
KAN_GCODE_WIFI_HOST=
KAN_GCODE_WIFI_PORT=
# Opcional (default 115200, el más común en Marlin/GRBL) — aplica solo al camino serial.
KAN_GCODE_BAUD_RATE=
