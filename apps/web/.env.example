# API key gratuita de Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional — modelo de Gemini a usar (por defecto: gemini-2.5-flash).
# gemini-2.0-flash fue retirado por Google el 2026-03-03 — si ves un error
# 429 con "limit: 0" en los logs, es señal de que el modelo default cambió
# de nuevo; revisa https://ai.google.dev/gemini-api/docs/rate-limits
GEMINI_MODEL=

# URL del Gateway (apps/gateway) — function-calling contra Edge Agents reales
KAN_GATEWAY_URL=http://localhost:8787
KAN_GATEWAY_INTERNAL_TOKEN=dev-internal-token

# Supabase (ADR-017, docs/00) — Project URL y anon public key desde
# Settings → API en tu proyecto de supabase.com. No hace falta la
# service_role key: todo pasa por RLS con la sesión del propio usuario.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq (ADR-014, docs/00) — STT para Voz Fase 1 (push-to-talk). Gratis, sin
# tarjeta: https://console.groq.com/keys
GROQ_API_KEY=
